// Secrets (ANTHROPIC_API_KEY, STRIPE_SECRET_KEY, STRIPE_PUBLISHABLE_KEY,
// STRIPE_WEBHOOK_SECRET, SENTRY_DSN) are NOT declared here. Set them with
// `wrangler secret put <NAME>` for deployed environments, and copy
// .dev.vars.example to .dev.vars (gitignored) for local `wrangler dev`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eshop",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-09",
  "compatibility_flags": ["nodejs_compat"],
  // The HTML documents run through the worker so it can stamp ENV_LABEL into
  // them (src/lib/branding.ts). Dropping one from run_worker_first serves it
  // straight from the asset server, unlabelled and with no error — so the list
  // is pinned against the worker's own routes in tests/node/branding.test.ts.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/index.html", "/admin.html"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eshop-db",
      "database_id": "a1a82243-3632-4add-a3b7-bfcff7f248f6"
    }
  ],
  // R2 is not enabled on this account. Seeded product images ship as static
  // assets under public/media/. Re-add an r2_buckets entry binding MEDIA to
  // turn admin image uploads back on; no other change is needed.
  "vars": {
    "STRIPE_CURRENCY": "eur",
    "PASSWORD_HASH_ITERATIONS": 100000,
    // Suffixed onto the brand in the served HTML. Empty here on purpose: this
    // is production and it must render as plain "eshop".
    "ENV_LABEL": ""
  },
  // `assets` is inherited by environments; `vars` and bindings are NOT — every
  // env must repeat them or it silently deploys without them. tests/node/envs
  // asserts this against wrangler's own resolver, and that no two environments
  // ever share a database_id.
  "env": {
    "dev": {
      "name": "eshop-dev",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "eshop-db-dev",
          "database_id": "6c946ab6-c209-4293-a11c-7e7a4ee24cd5"
        }
      ],
      "vars": {
        "STRIPE_CURRENCY": "eur",
        "PASSWORD_HASH_ITERATIONS": 100000,
        "ENV_LABEL": "-test"
      }
    }
  }
}
